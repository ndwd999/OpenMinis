<?xml version="1.0" encoding="utf-8"?>
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This build ships English and Simplified Chinese only. Every other
         translation that upstream carried (values-de, -es, -fil, -fr, -hr,
         -in, -ja, -ko, -ms, -pl, -pt-rBR, -ro, -ru, -th, -tr, -zh-rTW) was
         removed, so only these two tags resolve to a real translation; any
         other device locale falls back to values/English.

         "zh" is the res qualifier as well as the tag: Android treats a bare
         "zh" as Simplified, so a bare tag resolves to values-zh without
         pinning a region the app has no separate translation for. -->
    <locale android:name="en"/>
    <locale android:name="zh"/>
</locale-config>
